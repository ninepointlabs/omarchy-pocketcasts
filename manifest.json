{
  "schemaVersion": 1,
  "id": "ninepointlabs.pocketcasts",
  "name": "Pocket Casts",
  "version": "0.1.0",
  "author": "Ninepoint Labs",
  "license": "MIT",
  "description": "Pocket Casts in the Omarchy bar — sign in, play your Up Next, in-progress and new episodes through mpv, browse your shows, and keep your listening position in sync with your phone.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Pocket Casts",
    "description": "Now playing in the bar; click for the player, Up Next, In Progress, New releases and your podcasts.",
    "category": "Media",
    "aliases": [
      "pocketcasts",
      "pocket casts",
      "podcasts",
      "podcast"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showTitle": true,
      "maxLabelWidth": 180,
      "defaultTab": "upnext",
      "skipBack": 10,
      "skipForward": 30,
      "autoplay": true
    },
    "schema": [
      {
        "key": "showTitle",
        "type": "boolean",
        "label": "Show the episode title next to the cover",
        "defaultValue": true
      },
      {
        "key": "maxLabelWidth",
        "type": "integer",
        "label": "Max width of the title label (px)",
        "min": 60,
        "max": 600,
        "step": 10,
        "defaultValue": 180
      },
      {
        "key": "defaultTab",
        "type": "enum",
        "label": "Tab to open first",
        "options": [
          "upnext",
          "progress",
          "new",
          "podcasts"
        ],
        "defaultValue": "upnext"
      },
      {
        "key": "skipBack",
        "type": "integer",
        "label": "Skip back (seconds)",
        "min": 5,
        "max": 120,
        "step": 5,
        "defaultValue": 10
      },
      {
        "key": "skipForward",
        "type": "integer",
        "label": "Skip forward (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "autoplay",
        "type": "boolean",
        "label": "Play the next Up Next episode when one finishes",
        "defaultValue": true
      }
    ]
  }
}
